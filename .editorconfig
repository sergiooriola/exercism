# EditorConfig keeps basic formatting consistent across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

# Trailing spaces are meaningful in Markdown (they force a line break).
[*.md]
trim_trailing_whitespace = false
